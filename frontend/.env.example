# API Configuration
# URL da API backend

# Para desenvolvimento local (sua máquina):
# REACT_APP_API_URL=http://localhost:5000/api

# Para acesso via rede (outras máquinas):
# REACT_APP_API_URL=http://192.168.6.31:5000/api

# Como usar:
# 1. Copie este arquivo para .env
# 2. Descomente e use a URL apropriada para seu ambiente
#
# OU use os scripts npm:
# - npm run env:local      (configura para localhost)
# - npm run env:production (configura para rede)

REACT_APP_API_URL=http://192.168.6.31:5000/api
