{
  "name": "projeto-atividades-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.0",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "jwt-decode": "^4.0.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-confirm-alert": "^3.0.6",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "react-toastify": "^11.0.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:local": "env-cmd -f .env.localhost react-scripts start",
    "start:trabalho": "env-cmd -f .env.trabalho react-scripts start",
    "start:production": "env-cmd -f .env.production react-scripts start",
    "build": "react-scripts build",
    "build:local": "env-cmd -f .env.localhost react-scripts build",
    "build:trabalho": "env-cmd -f .env.trabalho react-scripts build",
    "build:production": "env-cmd -f .env.production react-scripts build",
    "env:local": "cp .env.localhost .env && echo '✅ Ambiente configurado para LOCALHOST'",
    "env:production": "cp .env.production .env && echo '✅ Ambiente configurado para REDE (192.168.6.31)'",
    "env:trabalho": "cp .env.trabalho .env && echo '✅ Ambiente configurado para TRABALHO'",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000",
  "devDependencies": {
    "env-cmd": "^11.0.0"
  }
}
